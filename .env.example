# Copy to .env and fill in values:
#   cp .env.example .env
#
# --- Required for Vertex training / deploy ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Bucket name only (no gs:// prefix)
GCS_BUCKET=

HF_TOKEN=

# --- Model & artifact paths ---
MODEL_ID=google/gemma-4-E2B-it
# Must match OUTPUT_GCS_PREFIX from the training run whose merged/ you want (Gradio + query_finetuned_gemma.py --sync).
# Verify: gcloud storage ls gs://$GCS_BUCKET/<prefix>/merged/
OUTPUT_GCS_PREFIX=gemma-sql/gemma-4-e2b-run-1
# Optional: subfolder under <repo>/.cache/ for merged weights (default: gemma-sql-merged). Legacy: LOCAL_FT_MERGED_DIR basename is still read if unset.
LOCAL_FT_MERGED_CACHE_NAME=gemma-sql-merged
# LOCAL_FT_DEVICE_MAP=auto

# --- Vertex container images (optionally pin tags / digests; list: gcloud container images list-tags <image path>) ---
# PyTorch Training DLC: https://huggingface.co/docs/google-cloud/containers/available
TRAINING_CONTAINER_URI=us-docker.pkg.dev/deeplearning-platform-release/gcr.io/huggingface-pytorch-training-cu121.2-3.transformers.4-48.ubuntu2204.py311:latest
VLLM_SERVING_CONTAINER_URI=us-docker.pkg.dev/vertex-ai/vertex-vision-model-garden-dockers/pytorch-vllm-serve:latest

# --- Training compute ---
# 1×L4: g2-standard-12. Multi-GPU on one VM: use scripts/finetune_deploy_gemma4_torchrun.py (DDP); finetune_deploy_gemma4.py pins CUDA_VISIBLE_DEVICES=0 if count>1.
TRAINING_MACHINE_TYPE=g2-standard-12
TRAINING_ACCELERATOR_TYPE=NVIDIA_L4
TRAINING_ACCELERATOR_COUNT=1

# --- Serving compute ---
SERVING_MACHINE_TYPE=g2-standard-12
SERVING_ACCELERATOR_TYPE=NVIDIA_L4
SERVING_ACCELERATOR_COUNT=1
SERVING_MIN_REPLICAS=1
SERVING_MAX_REPLICAS=1

# --- Training hyperparameters (passed into the training container) ---
# 1×L4 ~2h train-loop budget: fewer rows + MAX_STEPS cap; bootstrap pip/HF + merge add more wall time.
NUM_TRAIN_EPOCHS=1
MAX_TRAIN_EXAMPLES=10000
# ~480 steps × ~12–15 s/step ≈ 1.6–2.0 h on 1×L4 + Gemma 4 + seq 512 (tune from logs).
MAX_STEPS=480
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=16
LEARNING_RATE=2e-4
# 512 matches typical sql-create-context lengths; if L4 OOM, try 384/256.
MAX_SEQ_LENGTH=512
PACKING=false
GRADIENT_CHECKPOINTING=true
BF16=true
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
MERGE_AFTER_TRAIN=true

# --- train_sql_sft.py bootstrap (inside the HF Training DLC; omitted env vars use code defaults) ---
# Upgrade PyTorch to CUDA wheels before upgrading Transformers (needed for Gemma 4 + Transformers 5.x).
VERTEX_UPGRADE_TORCH=1
# Default in code matches cu121 DLC; override if you use a different training image (see pytorch.org/get-started).
# TORCH_PIP_INDEX_URL=https://download.pytorch.org/whl/cu121
# TRL default device_map=auto: on CPU use none to avoid meta-tensor errors (train_sql_sft does this when no CUDA).
# MODEL_DEVICE_MAP=auto

# Optional: passed into training worker (see scripts/finetune_deploy_gemma4.py)
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Deploy / vLLM ---
# Defaults for serving_container_args; DEPLOY_MAX_MODEL_LEN overrides MAX_SEQ_LENGTH for --max-model-len if set
TENSOR_PARALLEL_SIZE=1
# DEPLOY_MAX_MODEL_LEN=4096
# HF_TOKEN is passed into the serving container (gated Gemma).
# vLLM needs a large /dev/shm on Vertex (default below matches Google’s vLLM sample).
# SERVING_SHARED_MEMORY_MB=16384
# SERVING_DEPLOYMENT_TIMEOUT_SEC=3600
# Service account for pods reading gs://…/merged (grant roles/storage.objectViewer on GCS_BUCKET):
# VERTEX_PREDICTION_SERVICE_ACCOUNT=vertex-predict-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com
# Optional CLI overrides:
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_EXTRA_ARGS=--trust-remote-code
# Pin VLLM_SERVING_CONTAINER_URI to a recent tag if deploy fails with "Model server exited unexpectedly"

# --- Job / resource display names ---
DISPLAY_NAME_TRAINING=gemma4-sql-sft
DISPLAY_NAME_MODEL=gemma4-sql-ft
DISPLAY_NAME_ENDPOINT=gemma4-sql-endpoint

# Force CPU training (e.g. Mac without CUDA — avoids MPS for huge models). Smoke runs set this via SMOKE_MAX_EXAMPLES.
# TRAINING_USE_CPU=1

# Steps are chosen with CLI flags only: --train, --deploy (see scripts/finetune_deploy_gemma4.py --help)

# --- Qwen3.5 (train_qwen_sql_sft.py, scripts/finetune_deploy_qwen.py, scripts/query_finetuned_qwen.py) ---
# Model: Qwen/Qwen3.5-0.8B (small LM; 1×L4). Dataset: b-mc2/sql-create-context (~78k rows).
# Training container: TRAINING_CONTAINER_URI = Hugging Face PyTorch Training DLC (Google `deeplearning-platform-release`).
# Quality-biased ~2h: one full pass on 16k shuffled rows (≈1000 steps @ eff.batch 16), seq 768, LoRA r=32,
# cosine LR + warmup, eval + load_best; QWEN_MAX_STEPS caps worst case. If OOM, drop QWEN_MAX_SEQ_LENGTH to 512.
#
# Paths & local cache (sync merged: uv run python scripts/query_finetuned_qwen.py --sync)
QWEN_MODEL_ID=Qwen/Qwen3.5-0.8B
QWEN_OUTPUT_GCS_PREFIX=qwen-sql/l4-2h-quality1
LOCAL_QWEN_MERGED_CACHE_NAME=qwen-sql-merged
# Local inference device (see sql_compare_ui_qwen/inference_device.py): unset = MPS on Apple Silicon when available.
# LOCAL_QWEN_DEVICE_MAP=mps
# QWEN_COMPARE_MPS_DTYPE=fp16
# QWEN_GCS_MERGED_URI=gs://YOUR_BUCKET/qwen-sql/l4-2h-quality1/merged

# Vertex: 1×L4 (QWEN_* wins over TRAINING_* / SERVING_*). A100: a2-highgpu-1g + NVIDIA_TESLA_A100.
QWEN_TRAINING_MACHINE_TYPE=g2-standard-12
QWEN_TRAINING_ACCELERATOR_TYPE=NVIDIA_L4
QWEN_TRAINING_ACCELERATOR_COUNT=1
QWEN_SERVING_MACHINE_TYPE=g2-standard-12
QWEN_SERVING_ACCELERATOR_TYPE=NVIDIA_L4
QWEN_SERVING_ACCELERATOR_COUNT=1

# Training + merge (merged/ for local pull)
QWEN_MERGE_AFTER_TRAIN=true
QWEN_NUM_TRAIN_EPOCHS=1
QWEN_MAX_TRAIN_EXAMPLES=16000
QWEN_MAX_STEPS=1050
QWEN_MAX_SEQ_LENGTH=768
QWEN_PER_DEVICE_TRAIN_BATCH_SIZE=4
QWEN_GRADIENT_ACCUMULATION_STEPS=4
QWEN_LEARNING_RATE=5e-5
QWEN_LORA_R=32
QWEN_LORA_ALPHA=64
QWEN_LORA_DROPOUT=0.05
QWEN_LR_SCHEDULER_TYPE=cosine
QWEN_WARMUP_RATIO=0.06
QWEN_GRADIENT_CHECKPOINTING=true
QWEN_PACKING=false
QWEN_TRAIN_EVAL_STEPS=200
# QWEN_BF16=true
# QWEN_VERTEX_UPGRADE_TORCH=1

QWEN_DISPLAY_NAME_TRAINING=qwen35-sql-l4-quality
QWEN_DISPLAY_NAME_MODEL=qwen35-sql-l4-quality-ft
QWEN_DISPLAY_NAME_ENDPOINT=qwen35-sql-l4-quality-endpoint

# Train on Vertex: uv run python scripts/finetune_deploy_qwen.py --train
# SKIP_DEPLOY=true recommended until MERGE_AFTER_TRAIN=true and merged/ exists
# Local smoke: ./scripts/local_smoke_train_qwen.sh   (faster: FAST_SMOKE=1 ./scripts/local_smoke_train_qwen.sh)

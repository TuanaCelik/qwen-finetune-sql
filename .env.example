# Copy to .env and fill in values:
#   cp .env.example .env

# --- Required for Vertex training / deploy ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Bucket name only (no gs:// prefix)
GCS_BUCKET=

HF_TOKEN=

# --- Gemini: generate SFT JSONL (scripts/generate_sql_sft_data_gemini.py) ---
# Developer API (AI Studio): set one of these OR use Vertex with GCP_PROJECT_ID below.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Default model id (Flash is cheap; Vertex often uses a -001 suffix — see script docstring).
# GEMINI_SQL_GEN_MODEL=gemini-3-flash-preview
# Vertex only: Gemini 3 preview defaults to location "global" (regional endpoints 404). Override if needed:
# GEMINI_VERTEX_LOCATION=global

# --- Qwen model, dataset, and artifact paths ---
QWEN_MODEL_ID=Qwen/Qwen3.5-0.8B
# Default dataset when unset: b-mc2/sql-create-context
# QWEN_DATASET_ID=Tuana/synthetic-sql-dataset
QWEN_DATASET_SPLIT=train
# Must be unique per run unless you intentionally want to reuse a GCS location.
QWEN_OUTPUT_GCS_PREFIX=qwen-sql/qwen35-synthetic-1k-ep4
LOCAL_QWEN_MERGED_CACHE_NAME=qwen35-synthetic-1k-ep4
# Optional direct override for sync/query:
# QWEN_GCS_MERGED_URI=gs://YOUR_BUCKET/qwen-sql/qwen35-synthetic-1k-ep4/merged

# --- Vertex container images ---
# PyTorch Training DLC: https://huggingface.co/docs/google-cloud/containers/available
# PyTorch Inference DLC: https://huggingface.co/docs/google-cloud/containers/available#pytorch-inference
TRAINING_CONTAINER_URI=us-docker.pkg.dev/deeplearning-platform-release/gcr.io/huggingface-pytorch-training-cu121.2-3.transformers.4-48.ubuntu2204.py311:latest
INFERENCE_CONTAINER_URI=us-docker.pkg.dev/deeplearning-platform-release/gcr.io/huggingface-pytorch-inference-cu121.2-3.transformers.4-48.ubuntu2204.py311:latest

# --- Training compute ---
QWEN_TRAINING_MACHINE_TYPE=g2-standard-12
QWEN_TRAINING_ACCELERATOR_TYPE=NVIDIA_L4
QWEN_TRAINING_ACCELERATOR_COUNT=1

# --- Serving compute ---
QWEN_SERVING_MACHINE_TYPE=g2-standard-12
QWEN_SERVING_ACCELERATOR_TYPE=NVIDIA_L4
QWEN_SERVING_ACCELERATOR_COUNT=1
QWEN_SERVING_MIN_REPLICAS=1
QWEN_SERVING_MAX_REPLICAS=1

# Training hyperparameters live in scripts/train_qwen_sql_sft.py.

# --- Training container bootstrap ---
# Default in code matches the cu121 DLC; override if you use a different training image.
# TORCH_PIP_INDEX_URL=https://download.pytorch.org/whl/cu121
# TRL default device_map=auto; on CPU use none to avoid meta-tensor errors.
# MODEL_DEVICE_MAP=auto
# Optional allocator override for the training worker:
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Deploy / Hugging Face PyTorch inference DLC ---
# SERVING_DEPLOYMENT_TIMEOUT_SEC=3600
# Service account for pods reading gs://.../merged (grant roles/storage.objectViewer on GCS_BUCKET):
# VERTEX_PREDICTION_SERVICE_ACCOUNT=vertex-predict-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com

# --- Job / resource display names ---
QWEN_DISPLAY_NAME_TRAINING=qwen35-sql-l4-quality
QWEN_DISPLAY_NAME_MODEL=qwen35-sql-l4-quality-ft
QWEN_DISPLAY_NAME_ENDPOINT=qwen35-sql-l4-quality-endpoint

# --- Compare UI ---
# Fine-tuned model is hard-coded in the app: Tuana/qwen35-08b-text2sql.
# Inference device: unset = MPS on Apple Silicon when available.
# QWEN_COMPARE_HUB_MODEL_ID=Qwen/Qwen3.5-0.8B
# QWEN_COMPARE_DEVICE_MAP=mps
# QWEN_COMPARE_MPS_DTYPE=fp16
# QWEN_COMPARE_GRADIO_HOST=127.0.0.1
# QWEN_COMPARE_GRADIO_PORT=7861

# Train on Vertex:
#   uv run python scripts/finetune_deploy_qwen.py --train
# Skip deploy until merged/ exists:
#   SKIP_DEPLOY=true uv run python scripts/finetune_deploy_qwen.py --train
# Local smoke:
#   ./scripts/local_smoke_train_qwen.sh

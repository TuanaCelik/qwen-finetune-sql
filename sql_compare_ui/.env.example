# One-column only (value must be exactly 1):
# SQL_COMPARE_SKIP_HUB=1
# SQL_COMPARE_SKIP_LOCAL=1
# GRADIO_SERVER_PORT=7860
# SQL_COMPARE_DB_SCHEMA="..."

# Internal SQL agent tab (smolagents): SQLite DB path; Hub model for planner (defaults to MODEL_ID)

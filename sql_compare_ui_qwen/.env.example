# Optional: copy to sql_compare_ui_qwen/.env for UI-only overrides.
# Repo-root .env is also loaded (HF_TOKEN, QWEN_MODEL_ID, LOCAL_QWEN_MERGED_CACHE_NAME, QWEN_OUTPUT_GCS_PREFIX, …).

# Hub base model (defaults to QWEN_MODEL_ID from repo .env, else Qwen/Qwen3.5-0.8B)
# QWEN_COMPARE_HUB_MODEL_ID=Qwen/Qwen3.5-0.8B

# Local merged cache folder under <repo>/.cache/<name>/ (optional; if unset, LOCAL_QWEN_MERGED_CACHE_NAME is used)
# QWEN_COMPARE_LOCAL_MERGED_NAME=qwen-sql-merged

# Optional token for gated Hub models (else HF_TOKEN from repo .env)
# QWEN_COMPARE_HF_TOKEN=

# Max new tokens for both columns
# QWEN_COMPARE_MAX_NEW_TOKENS=512

# Unload local before Hub, then unload Hub (peak ~one large model)
# QWEN_COMPARE_SEQUENTIAL_UNLOAD=1

# Single-column mode (value exactly 1)
# QWEN_COMPARE_SKIP_HUB=1
# QWEN_COMPARE_SKIP_LOCAL=1

# Read-only SQLite for extracted SQL (default: repo data/spider_eval_synthetic/synthetic.db)
# QWEN_COMPARE_DB_PATH=

# Override default DDL in the prompt (multiline); if unset, same default schema as Gemma compare
# QWEN_COMPARE_DB_SCHEMA=

# Local load: unset = CUDA auto if available, else Apple MPS if available, else CPU.
# Explicit: auto | mps | cpu | none | cuda:0 (same for Hub via QWEN_COMPARE_HUB_DEVICE_MAP).
# QWEN_COMPARE_LOCAL_DEVICE_MAP=
# QWEN_COMPARE_HUB_DEVICE_MAP=
# MPS weight dtype: fp16 | bf16 | float32 (default float32 — set fp16 for speed if stable)
# QWEN_COMPARE_MPS_DTYPE=

# Gradio bind (default 7861 so Gemma compare can use 7860)
# QWEN_COMPARE_GRADIO_HOST=127.0.0.1
# QWEN_COMPARE_GRADIO_PORT=7861

# Set to 1 to show multiprocessing resource_tracker semaphore warnings
# QWEN_COMPARE_SHOW_RESOURCE_TRACKER_WARNINGS=0
